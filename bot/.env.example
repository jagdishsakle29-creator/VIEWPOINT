# Telegram Bot Token (Get from @BotFather on Telegram)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Admin Telegram IDs (Comma separated numbers, e.g. 123456789,987654321)
# You can get your Telegram user ID from @userinfobot
ADMIN_IDS=123456789

# WebApp Game URL (Your deployed Netlify / Vercel URL or ngrok HTTPS URL)
# Example: https://your-minegame-domain.netlify.app
WEBAPP_URL=https://your-minegame.netlify.app

# Optional: Official Telegram Channel or Group link for updates/support
SUPPORT_CHANNEL=@your_channel_username
SUPPORT_ADMIN=@your_admin_username

# Bonus Configuration
DAILY_BONUS_AMOUNT=50
REFERRAL_BONUS_AMOUNT=500
MIN_WITHDRAW_AMOUNT=200
